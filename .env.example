# Template for a local .env file. Copy to .env and fill in your values.
# .env is gitignored; this file is committed.

# Container image to deploy. Override to your private registry/tag if needed.
SSM_IMAGE=ghcr.io/ricgrangeia/server-space-manager-ai:latest
SSM_VERSION=dev

# Host port for the dashboard. LAN-only.
SSM_PORT=8080

# Pre-existing external Docker network where your vLLM container lives.
VLLM_NETWORK=ai-network

# Single shared password for the dashboard. Generate something strong:
#   openssl rand -base64 24
SSM_HTTP_PASSWORD=change-me

# Local LLM endpoint (vLLM / OpenAI-compatible).
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=

# Telegram alerts. Create a bot via @BotFather, then fetch chat_id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
